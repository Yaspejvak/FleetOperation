<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests that need no database, broker, cache or identity provider: the Fleet domain, its validators and
    handlers (against in-memory fakes of the ports), its message texts, its EF Core model, and the host's
    policies, endpoint metadata and persistence exception mapping.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      CS0436 only, and only here. GrpcServices decides which *service* stubs protoc emits; the *message*
      classes come out of every compilation of a .proto. So generating the client from
      fleet/v1/vehicles.proto in this project produces a second copy of Vehicle, VehicleType and the rest
      in the same csharp_namespace the referenced host assembly already publishes, and the compiler warns
      that the source copy wins. That is exactly what the test wants: the client speaks its own generated
      messages to the server's, over the wire, which is the point of the test. The alternative is to
      generate the client in a project of its own and reach it through an extern alias; that adds a
      project to the solution, which this fix pass does not cover.
      TreatWarningsAsErrors stays on, and no other diagnostic is silenced anywhere.
    -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fserp.FleetOperations.Api/Fserp.FleetOperations.Api.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <!-- Host tests: the real Program pipeline in memory, with tokens signed by an in-process test key (fleet-verifier, round 1). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!--
      gRPC host tests (round 4): a real gRPC client over the in-memory TestServer, so the status a caller
      observes is measured rather than assumed. Test-only; the host's own gRPC server packages are
      unchanged and no transport was added.
    -->
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <!-- Same version as the host, so the client and the server are generated by one protoc. -->
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The client half of the host's own contract, generated here and nowhere else. The host item stays
      GrpcServices="Server", so the deployed assembly carries no client stub and the two projects cannot
      produce ambiguous types for the same .proto. The file is linked, never copied: the test speaks the
      contract the host serves, and a change to it breaks this build.
    -->
    <Protobuf Include="../../src/Fserp.FleetOperations.Api/Protos/fleet/v1/vehicles.proto"
              GrpcServices="Client"
              ProtoRoot="../../src/Fserp.FleetOperations.Api/Protos"
              Link="Protos/fleet/v1/vehicles.proto" />
    <!--
      The same arrangement for the Operations contract (round 7), for the same reasons. The .proto itself
      is untouched: its field numbers are permanent, and the Api item stays GrpcServices="Server".
    -->
    <Protobuf Include="../../src/Fserp.FleetOperations.Api/Protos/operations/v1/missions.proto"
              GrpcServices="Client"
              ProtoRoot="../../src/Fserp.FleetOperations.Api/Protos"
              Link="Protos/operations/v1/missions.proto" />
  </ItemGroup>
</Project>
